# Board partagé en temps réel (optionnel).
# Sans ces variables, l'app reste 100% locale (localStorage) — elle marche quand même.
# Avec elles, tous les participants éditent le MÊME tableau, synchronisé en direct.
#
# 1. Crée un projet sur https://supabase.com
# 2. Settings → API : copie l'URL du projet et la clé "anon public".
# 3. Renseigne-les ci-dessous (en local : copie ce fichier en `.env`),
#    et dans Vercel : Project → Settings → Environment Variables.

NUXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NUXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Optionnel : cloisonner plusieurs ateliers sur le même projet Supabase.
NUXT_PUBLIC_BOARD_ID=default
